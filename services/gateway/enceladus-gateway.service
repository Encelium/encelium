# systemd unit for running the gateway without Docker.
# Put the gateway in /opt/enceladus-gateway, the upstream key in /etc/enceladus-gateway.env
# (GATEWAY_UPSTREAM_KEY=...), then: sudo systemctl enable --now enceladus-gateway
[Unit]
Description=Enceladus gateway
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/enceladus-gateway
EnvironmentFile=/etc/enceladus-gateway.env
ExecStart=/usr/bin/node src/main.ts
Restart=on-failure
User=enceladus
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/enceladus-gateway/data
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
