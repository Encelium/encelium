# systemd unit for running the gateway without Docker.
# Layout (see the deploy guide in services/gateway/README.md):
#   code:     /opt/encelium/services/gateway   (git clone of this repo)
#   config:   /opt/encelium/services/gateway/config.json
#   secrets:  /etc/encelium-gateway.env         (GATEWAY_UPSTREAM_KEY=…, GATEWAY_UPSTREAM_URL=…)
#   data:     /opt/encelium/services/gateway/data
# Then: sudo systemctl enable --now encelium-gateway
[Unit]
Description=Encelium gateway (invite keys, quotas, Encelus model access)
After=network-online.target
Wants=network-online.target

[Service]
User=encelium
Group=encelium
WorkingDirectory=/opt/encelium/services/gateway
EnvironmentFile=/etc/encelium-gateway.env
ExecStart=/usr/bin/node src/main.ts
Restart=on-failure
RestartSec=3

# The service sees the filesystem read-only except its data folder.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/encelium/services/gateway/data
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
