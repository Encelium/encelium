{
  "name": "encelium",
  "private": true,
  "description": "Encelium — a free, no-jargon AI agent for chat and coding.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "app": "npm run dev -w @encelium/desktop",
    "gallery": "npm run dev -w @encelium/ui",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "gateway": "npm start -w @encelium/gateway"
  },
  "engines": {
    "node": ">=22"
  }
}
